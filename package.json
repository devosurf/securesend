{
  "name": "securesend",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:claims": "vitest run --config scripts/claims/vitest.config.ts",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "dev": "pnpm -r --parallel dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "og": "tsx scripts/og/render.ts",
    "smoke": "playwright test",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/claims && tsc --noEmit -p scripts/og && tsc --noEmit -p e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/browser-playwright": "^4.1.10",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  }
}
