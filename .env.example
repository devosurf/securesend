# Postgres connection string. Migrations apply on boot, so a fresh database is
# all this needs.
DATABASE_URL=postgres://securesend:securesend@localhost:5432/securesend

# Port the API listens on. In production it also serves the built web app.
PORT=3000

# The most ciphertext one envelope's note, login and file list may add up to, in
# bytes. 256 KB by default, which is far more text than anyone pastes. Raising it
# costs you database rows; the browser refuses anything over the same number
# before it encrypts, so the sender is told early either way.
# MAX_ENVELOPE_BYTES=262144

# The most one whole secret may weigh: the envelope above plus every attached
# file, in bytes. 10 MB by default. This is the number that decides what your
# instance stores, and it is a total rather than a per-file limit because what
# costs you is the row, not how many files it took to fill it.
# MAX_TOTAL_BYTES=10485760

# How many files one envelope may carry. Not a storage limit, since the total
# above already is one: it bounds how many ciphertexts a single request can make
# the instance decode.
# MAX_ATTACHMENTS=10
