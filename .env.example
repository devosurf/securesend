# Postgres connection string. Migrations apply on boot, so a fresh database is
# all this needs.
DATABASE_URL=postgres://securesend:securesend@localhost:5432/securesend

# Port the API listens on. In production it also serves the built web app.
PORT=3000

# The most ciphertext one envelope's note and login may add up to, in bytes.
# 256 KB by default, which is far more text than anyone pastes. Raising it costs
# you database rows; the browser refuses anything over the same number before it
# encrypts, so the sender is told early either way.
# MAX_ENVELOPE_BYTES=262144
