# Postgres connection string. Migrations apply on boot, so a fresh database is
# all this needs.
DATABASE_URL=postgres://securesend:securesend@localhost:5432/securesend

# Port the API listens on. In production it also serves the built web app.
PORT=3000

# The most ciphertext one envelope's note, login and file list may add up to, in
# bytes. 256 KB by default, which is far more text than anyone pastes. Raising it
# costs you database rows; the browser refuses anything over the same number
# before it encrypts, so the sender is told early either way.
# MAX_ENVELOPE_BYTES=262144

# The most one whole secret may weigh: the envelope above plus every attached
# file, in bytes. 10 MB by default. This is the number that decides what your
# instance stores, and it is a total rather than a per-file limit because what
# costs you is the row, not how many files it took to fill it.
# MAX_TOTAL_BYTES=10485760

# How many files one envelope may carry. Not a storage limit, since the total
# above already is one: it bounds how many ciphertexts a single request can make
# the instance decode.
# MAX_ATTACHMENTS=10


# ---------------------------------------------------------------------------
# Rate limits
#
# There is no CAPTCHA here and no third-party script of any kind, so abuse is
# bounded structurally instead: one-time links, a 72 hour ceiling, the size caps
# above, and these.
#
# Each route gets two numbers. PER_HOUR is what a caller may keep spending;
# BURST is what they may spend back to back before that rate starts to matter.
# Both are needed: a rate alone refuses somebody sending three secrets in one
# minute, and a burst alone lets one caller spend a day's worth in a second.
#
# The counters are in memory in this process. Two things follow, and both are
# deliberate. If you run more than one container you get one limiter per
# container, and the numbers below are then per container. And nothing survives
# a restart, which is the same property that makes "anything keyed to an IP
# address expires within 24 hours" true: an entry is dropped as soon as it has
# refilled, and no entry lives longer than a day whatever it is doing.

# One sender's creates. The default is far past what a person sending links does
# and nowhere near worth a flood.
# CREATE_PER_HOUR=60
# CREATE_BURST=10

# One recipient's opens. A reveal destroys a row rather than making one, so this
# is here to bound work rather than storage.
# REVEAL_PER_HOUR=120
# REVEAL_BURST=20

# Status lookups, which is the most generous of the three because it is the most
# innocently busy: every arriving recipient reads one, every chat app's preview
# bot fetches one, and a sender's homepage asks about everything it remembers in
# one request per page load.
# STATUS_PER_HOUR=600
# STATUS_BURST=60

# The watermark: creates across the whole instance, every caller together. This
# is the number that decides what a flood from many addresses can cost you,
# because the per-caller limits are keyed on something the caller picks. Read it
# beside MAX_TOTAL_BYTES: at these defaults and a 72 hour ceiling, the most this
# instance can be holding at once is about 21,600 secrets. If that many at your
# size cap is more disk than you have, lower one of the two.
# INSTANCE_CREATE_PER_HOUR=300
# INSTANCE_CREATE_BURST=60

# Which header carries the caller's real address, if a proxy in front of this
# instance puts it in one: cf-connecting-ip behind Cloudflare, x-real-ip behind
# a typical nginx. Leave it unset and the socket is used, which nobody can forge.
#
# Only set this if your own proxy always overwrites the header on the way in.
# A header a client can send is a rate limit a client can walk around, which is
# why this is off by default rather than guessed. If the header holds a list,
# the last entry is used, since that is the one the nearest proxy appended.
# CLIENT_IP_HEADER=cf-connecting-ip


# ---------------------------------------------------------------------------
# Slack
#
# Optional. Leave all three unset and the instance behaves exactly as it does
# without Slack: the two Slack routes refuse everything, and nothing else on
# the instance changes.
#
# Self-hosters do not need the client pair at all. Point your own Slack app at
# your own instance with the manifest in docs/, install it from your own
# dashboard, and the signing secret below is the only value the flow reads.

# What proves a request came from Slack. Basic Information, App Credentials, in
# your app's dashboard. Every Slack request is HMAC signed with it, and a
# request that does not verify is refused before anything parses it.
# SLACK_SIGNING_SECRET=

# The install handshake behind the Add to Slack button, and nothing else. The
# token it mints is never used: the runtime flow holds no token, because a
# signed payload comes in and a one-time reply handle goes back out.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
