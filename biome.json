{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["!**/src/routeTree.gen.ts", "!**/drizzle"]
  },
  "overrides": [
    {
      "includes": ["apps/api/src/db/schema.ts"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/crypto/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    }
  ]
}
