{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* Half of what these files say runs in the page rather than in the runner, so
     * they need the browser's types as well as Node's. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
